{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": ["ESNext"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./build",
    "rootDir": "./",
    "moduleResolution": "nodenext",
    "baseUrl": "./",
    "allowJs": true,
    "sourceMap": true
  },
  "exclude": ["node_modules"]
}
